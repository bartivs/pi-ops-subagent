# --- Node / deps ---
node_modules/
npm-debug.log*

# --- Build artifacts ---
build/
dist/

# --- Local ops state (never committed) ---
# Env contracts may contain credentials (targets, connection lines)
.ops/contracts/
.ops/runs/
.ops/sessions/
runs/

# --- Temporary / coverage artifacts ---
*.tmp
*.temp
.tmp/
coverage/
.nyc_output/

# --- Local builder notes + private rules (never pushed) ---
.notes/

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
